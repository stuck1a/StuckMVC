## Core settings
Options -Indexes -MultiViews
AddDefaultCharset utf-8
DirectoryIndex index.php


## Protect configuration, dependency manifests, templates and other internal files
<FilesMatch "^(configs(\.local)?(\.example)?\.php|composer\.(json|lock)|phpunit\.xml(\.dist)?|README\.md)$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(tpl|conf|log|sql|cache|dist|sh|bak|swp)$">
  Require all denied
</FilesMatch>


## Security headers for all responses (static files included)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <If "%{HTTPS} == 'on'">
    Header always set Strict-Transport-Security "max-age=31536000"
  </If>
</IfModule>


<IfModule mod_rewrite.c>
  RewriteEngine on

  ## Only allow whitelisted request methods
  RewriteCond %{REQUEST_METHOD} !^(GET|POST|HEAD)$
  RewriteRule .* - [F,L]

  ## Enforce HTTPS (except for local development)
  RewriteCond %{HTTPS} !on
  RewriteCond %{HTTP_HOST} !^(127\.0\.0\.1|localhost)(:[0-9]+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  ## Block direct access to internal directories and hidden files (.git, .idea, .env, ...)
  RewriteRule ^(core|application|tmp|vendor|tests|bin)(/|$) - [F,L]
  RewriteRule (^|/)\. - [F,L]

  ## Deliver existing static files from the public directory directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^(out/|offline\.html$|robots\.txt$|favicon\.ico$) - [L]

  ## Everything else is handled by the front controller
  RewriteRule ^index\.php$ - [L]
  RewriteRule ^ index.php [L,QSA]
</IfModule>
